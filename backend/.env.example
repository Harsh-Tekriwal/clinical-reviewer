# Copy this file to .env and fill in your own values. Never commit the real .env.

# Free API key from https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults to gemini-2.5-flash if not set.
# Check https://ai.google.dev/gemini-api/docs/models for the current
# recommended Flash model before you deploy, since Google retires old
# model versions on a published schedule.
GEMINI_MODEL=gemini-2.5-flash

# Local dev default (SQLite, zero setup). In production, set this to your
# Postgres connection string (e.g. from Render).
DATABASE_URL=sqlite:///./clinical_reports.db
